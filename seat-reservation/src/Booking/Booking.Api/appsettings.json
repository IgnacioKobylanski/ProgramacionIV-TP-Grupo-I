{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Booking": "Host=localhost;Port=5432;Database=booking;Username=app;Password=app"
    },
    "Payment": {
        "Address": "http://localhost:5003"
    },
    "Booking": {
        "HoldSeconds": 120,
        "SeatPriceCents": 500000
    },
    "ServiceBus": {
        "TopicName": "grupo1-booking-topic",
        "SubscriptionName": "booking"
    },
    "Notifications": {
        "BaseUrl": "http://localhost:5004/"
    },
    "Auth": {
        "Authority": "http://localhost:8081/realms/seat-reservation",
        "RequireHttpsMetadata": false
    },
    "ServiceAuth": {
        "TokenEndpoint": "http://localhost:8081/realms/seat-reservation/protocol/openid-connect/token",
        "ClientId": "booking-service"
    }
}